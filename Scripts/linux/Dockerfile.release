# X4-1 (ADR-094): the image the Linux RELEASE is built in. Ubuntu 22.04 on purpose — a binary
# runs on the glibc it was built against and anything newer, so building on the validation
# image's 24.04 (glibc 2.39) would shut out Ubuntu 22.04, Debian 12 and everything of their age.
# 22.04 is glibc 2.35, GCC 11, CMake 3.22 (the project's minimum). Built by Scripts/release-linux.sh.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git ca-certificates pkg-config binutils file \
        libasound2-dev libjack-jackd2-dev libfreetype6-dev libfontconfig1-dev \
        libx11-dev libxcomposite-dev libxcursor-dev libxext-dev libxinerama-dev \
        libxrandr-dev libxrender-dev libxi-dev \
        libcurl4-openssl-dev libglu1-mesa-dev mesa-common-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
